<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="keywords"
		content="<%= context.config.define.APP_CONFIG_TIEN_TO_TRUONG %>, <%= context.config.define.APP_CONFIG_TEN_TRUONG_VIET_TAT_TIENG_ANH %>, Trực tuyến, HỆ THỐNG PHẦN MỀM CHỈ ĐẠO, ĐIỀU HÀNH - <%= context.config.define.APP_CONFIG_TEN_TRUONG.toUpperCase() %>, đào tạo" />
	<meta property="og:image" content="/metadata.png" />
	<meta name="description"
		content="HỆ THỐNG PHẦN MỀM CHỈ ĐẠO, ĐIỀU HÀNH - <%= context.config.define.APP_CONFIG_TEN_TRUONG.toUpperCase() %>" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
	<title>
		HỆ THỐNG PHẦN MỀM CHỈ ĐẠO, ĐIỀU HÀNH - <%= context.config.define.APP_CONFIG_TEN_TRUONG.toUpperCase() %>
	</title>
	<link rel="icon" href="<%= context.config.publicPath +'favicon.ico'%>" type="image/x-icon" />
	<style>
		:root {
			/* Hỗ trợ đổi màu realtime */
			--primary-color: var(--ant-primary-color);
			/* Background selected */
			--primary-1: var(--ant-primary-1)
		}
	</style>
</head>

<body>

	<!-- Load Facebook SDK for JavaScript -->
	<!-- Messenger Plugin chat Code -->
	<div id="fb-root"></div>

	<!-- Your Plugin chat code -->
	<div id="fb-customer-chat" class="fb-customerchat">
	</div>

	<script>
		var chatbox = document.getElementById('fb-customer-chat');
		chatbox.setAttribute("page_id", "101402285211797");
		chatbox.setAttribute("attribution", "biz_inbox");
	</script>

	<!-- Your SDK code -->
	<script>
		window.fbAsyncInit = function () {
			FB.init({
				xfbml: true,
				version: 'v18.0'
			});
		};

		(function (d, s, id) {
			var js, fjs = d.getElementsByTagName(s)[0];
			if (d.getElementById(id)) return;
			js = d.createElement(s); js.id = id;
			js.src = 'https://connect.facebook.net/vi_VN/sdk/xfbml.customerchat.js';
			fjs.parentNode.insertBefore(js, fjs);
		}(document, 'script', 'facebook-jssdk'));
	</script>

	<noscript>Xin lỗi, chúng tôi cần trình duyệt của bạn chạy Javascript</noscript>
	<div id="root"></div>

	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-3YRF0QQY4E"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag() { dataLayer.push(arguments); }
		gtag('js', new Date());

		gtag('config', 'G-3YRF0QQY4E');
	</script>

</body>

</html>