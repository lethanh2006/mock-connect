{
  "name": "ant-design-pro",
  "version": "5.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "format": "prettier --cache --write .",
    "prepare": "husky install",
    "postinstall": "max setup",
    "setup": "max setup",
    "start": "npm run dev",
    "push-rsync": "rsync -avzhe ssh --delete-before dist/ ubuntu@203.162.10.113:/var/www/slink.ptit.edu.vn/",
    "push-rsync-win": "rsync -avzh --chmod=755 --no-perms --delete-before dist/ ubuntu@203.162.10.113:/var/www/slink.ptit.edu.vn/",
    "deploy": "yarn build && yarn push-rsync",
    "deploy-win": "yarn build && yarn push-rsync-win",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "lint": "max setup && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src && npm run lint:style",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"src/**/*\" --end-of-line auto",
    "lint:style": "stylelint --fix \"src/**/*.less\" --syntax less",
    "precommit": "lint-staged",
    "prettier": "prettier -c --write \"src/**/*\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org aisoft --project sentry-vwa build && sentry-cli --url https://sentry.aisoftech.vn/ sourcemaps upload --org aisoft --project sentry-vwa build"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.0.1",
    "@ant-design/pro-components": "^2.6.49",
    "@ant-design/pro-layout": "7.22.1",
    "@babel/core": "^7.0.0",
    "@react-dev-inspector/umi4-plugin": "^2.0.1",
    "@sentry/react": "^8.54.0",
    "@tinymce/tinymce-react": "^5.1.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react-highlight-words": "^0.20.0",
    "@types/styled-components": "^5.1.34",
    "@umijs/max": "^4.1.1",
    "@umijs/plugin-model": "^2.6.2",
    "@umijs/route-utils": "^4.0.1",
    "antd": "^5.23.3",
    "antd-img-crop": "^4.24.0",
    "apexcharts": "^4.4.0",
    "axios": "^1.7.9",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.10",
    "js-file-download": "^0.4.12",
    "lodash": "^4.17.21",
    "oidc-client-ts": "^3.1.0",
    "path": "^0.12.7",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-beautiful-dnd": "^13.1.0",
    "react-big-calendar": "^1.17.1",
    "react-countup": "^6.5.3",
    "react-dev-inspector": "^2.0.1",
    "react-dom": "^19.0.0",
    "react-highlight-words": "^0.21.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-oidc-context": "^3.2.0",
    "react-onesignal": "^3.0.1",
    "react-pdf": "^9.2.1",
    "react-responsive": "^10.0.0",
    "react-router": "^7.1.5",
    "react-sortable-hoc": "^2.0.0",
    "react-split-pane": "^2.0.3",
    "react-to-print": "^3.0.5",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.14",
    "tinymce": "^7.6.1",
    "umi-serve": "~1.9.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/history": "^5.0.0",
    "@types/lodash": "^4.17.15",
    "@types/react": "^19.0.8",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-big-calendar": "^1.16.1",
    "@types/react-dom": "^19.0.3",
    "@types/react-pdf": "^7.0.0",
    "@umijs/fabric": "^4.0.1",
    "cross-env": "^7.0.0",
    "enzyme": "^3.11.0",
    "eslint": "^9.19.0",
    "express": "^4.21.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.4.3",
    "stylelint": "^16.14.1",
    "typescript": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "gitHooks": {
    "commit-msg": "fabric verify-commit"
  }
}
